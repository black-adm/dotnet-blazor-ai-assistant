@page "/player/{Slug}"
@rendermode InteractiveServer

@using AIAssistant.Components.Player.Data
@using Microsoft.AspNetCore.Components.Web

@inject IVideoRepository _videoRepository

<style>
    .message-user {
        max-width: 70%;
    }
    
    .message-ai {
        max-width: 70%;
    }
    
    .container-custom {
        height: 94vh !important;
    }
    
    .chat-history {
        height: 70vh;
        overflow-y: auto;
    }
</style>

<div class="container-fluid container-custom">
    <div class="row h-100">
        
        <div class="col-lg-8 col-md-12 mb-3">
            <div class="ratio ratio-16x9" style="margin-bottom: 15px;">
                <iframe src="@video.Url" allowfullscreen></iframe>
            </div>

            <h2>@video.Name</h2>

            <div class="d-flex justify-content-lg-start">
                <button class="btn btn-primary me-2">
                    Curtir
                </button>
                <button class="btn btn-secondary me-2">
                    Compartilhar
                </button>
            </div>
        </div>
        
        <div class="col-lg-4 col-md-12 d-flex flex-column">
            <div class="chat-history flex-grow-1 mb-3" style="overflow-y: auto; border: 1px solid #ccc; border-radius: .25rem; padding: 10px;">
                @foreach (var message in Messages)
                {
                    if (message.IsUser)
                    {
                        <div class="d-flex justify-content-end mb-2">
                            <div class="message-user bg-primary text-white p-2 rounded">
                                @message.Text
                            </div>
                            <img src="/images/avatar-user.png" alt="User Avatar" class="rounded-circle ms-2" style="width: 40px; height: 40px;" />
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-start mb-2">
                            <img src="/images/avatar-assistent.png" alt="AI Avatar" class="rounded-circle me-2" style="width: 40px; height: 40px;" />
                            <div class="message-ai bg-light p-2 rounded">
                                @message.Text
                            </div>
                        </div>
                    }
                }
            </div>
            
            <div>
                <textarea class="form-control mb-2" placeholder="Digite sua mensagem" 
                    rows="3" @bind="UserMessage"></textarea>
                
                <button class="btn btn-primary w-100" type="button" @onclick="SendMessage">Enviar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Slug { get; set; }

    private Video video;
    private string UserMessage { get; set; }
    private List<Message> Messages { get; set; } = new List<Message>();
    
    private class Message
    {
        public string Text { get; set; }
        public bool IsUser { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        video = await _videoRepository.GetBySlugAsync(Slug);
     
        Messages.Add(new Message { 
            Text = "Olá, sou o seu assistente de estudos. Fique a vontade para perguntar sobre qualquer assunto!", 
            IsUser = false });
    }

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(UserMessage))
        {
            Messages.Add(new Message { Text = UserMessage, IsUser = true });
            
            var response = GenerateDummyResponse();
            Messages.Add(new Message { Text = response, IsUser = false });
            
            UserMessage = string.Empty;
        }
    }

    private string GenerateDummyResponse()
    {
        var answers = new List<string>
        {
            "Essa é uma resposta dummy.",
            "Você pode tentar isso!",
            "Verifique as configurações novamente",
            "Isso parece interessante!",
            "Que tal tentar uma abordagem diferente?"
        };
        
        var random = new Random();
        int index = random.Next(answers.Count);
        return answers[index];
    }
}